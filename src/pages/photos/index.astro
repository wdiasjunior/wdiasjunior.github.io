---

import Layout from '../../layouts/Layout.astro';

---

<Layout title="Photos - wdias.dev">
  <main>
    <div class="photos_blog_container">
      <h1>Photos</h1>
      <span>a compilation of photos I take on occasional trips.</span>

      <div class="list">

        <a class="item" href="/photos/2023">
          <span>2023</span>
        </a>

        <a class="item" href="/photos/2020">
          <span>2020</span>
        </a>

        <a class="item" href="/photos/2018">
          <span>2018</span>
        </a>

      </div>

    </div>
  </main>
</Layout>

<style>
  .photos_blog_container {
    margin-bottom: 30px;

    .list {
      display: flex;
      flex-direction: column;
      gap: 26px;
      padding-top: 47px;

      .item {
        display: flex;
        flex-direction: column;

        :is(span) {
          font-size: 1.125rem;
          font-weight: bold;
        }

        :is(span):hover {
          color: var(--accent);
          text-decoration: underline;
        }
      }
    }
  }
</style>
